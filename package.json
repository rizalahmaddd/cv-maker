{
  "name": "cv-maker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Aplikasi pembuat CV & surat lamaran 100% client-side: 30 template (siap ATS, formal, Daftar Riwayat Hidup, Europass, Rirekisho Jepang), ekspor PDF/Word/gambar, cek CV, impor PDF/LinkedIn, pelacak lamaran. PWA, bisa offline.",
  "keywords": [
    "cv",
    "resume",
    "cv-maker",
    "resume-builder",
    "curriculum-vitae",
    "surat-lamaran",
    "cover-letter",
    "ats",
    "rirekisho",
    "indonesia",
    "pwa",
    "offline-first",
    "react-pdf",
    "typescript"
  ],
  "license": "MIT",
  "author": "rizalahmaddd",
  "homepage": "https://cv.solusikoding.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/rizalahmaddd/cv-maker.git"
  },
  "bugs": {
    "url": "https://github.com/rizalahmaddd/cv-maker/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/icons.mjs",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "buffer": "^6.0.3",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^1.1.7",
    "docx": "^9.13.0",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.151.3"
  }
}
